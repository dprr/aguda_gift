# Copy to .env for local development. Port 5433 avoids a clash with a local PostgreSQL.
DATABASE_URL=postgres://aguda:localdev@127.0.0.1:5433/aguda

# A sync run stops, and writes nothing, when the university response holds fewer
# students than this. Plan §5.3 step 3. The real list (2026) holds about 15,300 students.
SYNC_MIN_STUDENTS=13000

# Request 11: the periodic sync. Empty = off. "fake" = invented students, refused in
# production. "university" = the real list, from the university service (request 27).
SYNC_SOURCE=
# Only for SYNC_SOURCE=university. The key is a secret: never in git or in chat.
HUJI_API_KEY=
HUJI_CURRENT_YEAR=2026
SYNC_INTERVAL_HOURS=24
# Only for SYNC_SOURCE=fake. Must be at least SYNC_MIN_STUDENTS, or every run is refused.
FAKE_STUDENTS=2000

# Google OAuth client (plan §2). The secret never goes into git or into chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the login cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Staff (managers and workers) are rows in the staff table, not settings here.
# Add the first manager with: npm run staff -- manager <email>
# Which Google Workspace domains may log in at each login page. These are the defaults.
# STUDENT_DOMAINS=mail.huji.ac.il
# STAFF_DOMAINS=mail.huji.ac.il,aguda.org.il

# Development only. Shows a login form that skips Google. Refused when NODE_ENV=production,
# unless DEMO=1.
DEV_LOGIN=1

# A public demonstration with invented data: allows DEV_LOGIN and SYNC_SOURCE=fake in
# production, and puts a red banner on every page. Never set it on a site with real data.
DEMO=

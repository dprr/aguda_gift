# Copy to .env for local development. Port 5433 avoids a clash with a local PostgreSQL.
DATABASE_URL=postgres://aguda:localdev@127.0.0.1:5433/aguda

# A sync run stops, and writes nothing, when the university response holds fewer
# students than this. Plan §5.3 step 3.
SYNC_MIN_STUDENTS=20000

# Google OAuth client (plan §2). The secret never goes into git or into chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the login cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Development only. Shows a login form that skips Google. Refused when NODE_ENV=production.
DEV_LOGIN=1

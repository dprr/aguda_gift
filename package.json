{
  "name": "aguda-gifts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d && node src/wait-for-db.ts",
    "db:down": "docker compose down -v",
    "migrate": "node src/migrate.ts",
    "seed": "node src/seed.ts",
    "staff": "node --env-file-if-exists=.env src/staff.ts",
    "pretest": "node test/create-db.ts",
    "test": "DATABASE_URL=postgres://aguda:localdev@127.0.0.1:5433/aguda_test node --test --test-concurrency=1 'test/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "seed-demo": "node src/seed-demo.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/formbody": "^9.0.1",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.2.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.9.0"
  }
}
